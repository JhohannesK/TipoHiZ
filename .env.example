# OAuth providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# MongoDB connection string. Better Auth reads this.
MONGODB_URI=""

# Better Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin, no trailing slash. Production: https://tipohiz.vercel.app
# On Vercel, an unset value falls back to the stable branch host.
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins, comma-separated. BETTER_AUTH_URL and VERCEL_URL are added too.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Register these OAuth callback URLs with Google, GitHub, and X:
# ${BETTER_AUTH_URL}/api/auth/callback/google
# ${BETTER_AUTH_URL}/api/auth/callback/github
# ${BETTER_AUTH_URL}/api/auth/callback/twitter
