{
   "compilerOptions": {
      "target": "es6",
      "lib": ["dom", "dom.iterable", "esnext"],
      "allowJs": true,
      "skipLibCheck": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "noEmit": true,
      "incremental": true,
      "esModuleInterop": true,
      "module": "esnext",
      "resolveJsonModule": true,
      "moduleResolution": "bundler",
      "isolatedModules": true,
      "jsx": "react-jsx",
      "paths": {
         "@/*": ["./*"]
      },
      "plugins": [
         {
            "name": "next"
         }
      ]
   },
   "include": [
      "next-env.d.ts",
      "**/*.ts",
      "**/*.tsx",
      ".next/types/**/*.ts",
      ".next/dev/types/**/*.ts"
   ],
   "exclude": ["node_modules"]
}
